<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" spacing="15.0" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.mycompany.proyectosChristian.PrimaryController">
   <children>
      <HBox alignment="CENTER" spacing="10.0">
         <children>
            <Label text="Dinero:" />
            <TextField fx:id="txtDinero" alignment="CENTER_RIGHT" prefWidth="110.0" />
            <Button onAction="#borrarEntrada" prefWidth="30.0" text="X" />
            <Button onAction="#desglosar" prefWidth="90.0" text="Desglosar" />
         </children>
      </HBox>

      <HBox alignment="CENTER" spacing="15.0">
         <children>
            <VBox alignment="TOP_RIGHT" spacing="4.0" style="-fx-border-color: #808080; -fx-padding: 8 12 8 12;">
               <children>
                  <Label text="Billetes de $500" />
                  <Label text="Billetes de $200" />
                  <Label text="Billetes de $100" />
                  <Label text="Billetes de $50" />
                  <Label text="Billetes de $20" />
                  <Label text="Monedas de $10" />
                  <Label text="Monedas de $5" />
                  <Label text="Monedas de $2" />
                  <Label text="Monedas de $1" />
               </children>
            </VBox>

            <VBox alignment="TOP_LEFT" prefWidth="120.0" spacing="4.0" style="-fx-border-color: #808080; -fx-padding: 8 12 8 12;">
               <children>
                  <Label fx:id="lbl500" text="0" />
                  <Label fx:id="lbl200" text="0" />
                  <Label fx:id="lbl100" text="0" />
                  <Label fx:id="lbl50" text="0" />
                  <Label fx:id="lbl20" text="0" />
                  <Label fx:id="lbl10" text="0" />
                  <Label fx:id="lbl5" text="0" />
                  <Label fx:id="lbl2" text="0" />
                  <Label fx:id="lbl1" text="0" />
               </children>
            </VBox>
         </children>
      </HBox>
   </children>
   <padding>
      <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
   </padding>
</VBox>