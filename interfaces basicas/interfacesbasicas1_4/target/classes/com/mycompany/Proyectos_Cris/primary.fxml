<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="TOP_CENTER" spacing="15.0" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.mycompany.Proyectos_Cris.PrimaryController">
   <children>
  <HBox alignment="CENTER_LEFT" spacing="30.0">
         <children>
            
            <VBox spacing="8.0">
               <children>
                  <Label text="Tabla del:" />
                  <TextField fx:id="txtNumero" prefWidth="50.0" alignment="CENTER" />
               </children>
            </VBox>


            <VBox spacing="8.0">
               <children>
                  <Button text="Calcular" onAction="#calcular" prefWidth="85.0" />
                  <Button text="Limpiar" onAction="#limpiar" prefWidth="85.0" />
               </children>
            </VBox>
         </children>
      </HBox>

      <!-- Área para desplegar la tabla -->
      <TextArea fx:id="txtResultado" editable="false" prefHeight="220.0" prefWidth="200.0" />
   </children>
   <padding>
      <Insets bottom="20.0" left="25.0" right="25.0" top="20.0" />
   </padding>
</VBox>